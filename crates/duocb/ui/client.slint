// The join-a-connection screen: the paired summary plus the session panel.
// Joining always starts from the home hub's device picker, so there is no
// credential form here — the pre-connect state is a brief transient.

import { UiState, Actions } from "globals.slint";
import { Theme } from "theme.slint";
import { Body, Weak, BackHeader, IdentityPairingSummary } from "widgets.slint";
import { SessionPanel } from "session.slint";
import { Button, ScrollView } from "std-widgets.slint";

export component ClientScreen inherits ScrollView {
    out property <bool> field-focused: session.field-focused;
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-m;

        BackHeader { title: "Join a connection"; }
        Body { text: "Status: " + UiState.status-text; }

        if !UiState.client-active: Weak {
            // A join launches from the home hub with the selected peer already
            // chosen; this state is a brief transient.
            text: "Pick a device to join from the home screen.";
        }

        if UiState.client-active: IdentityPairingSummary { }
        if UiState.client-active: HorizontalLayout {
            alignment: start;
            Button {
                text: "✕ Disconnect (Esc)";
                clicked => { Actions.disconnect(); }
            }
        }

        session := SessionPanel { }
    }
}
