// The home screen: the configure mode's setup wizard, the configured hub, and
// the device picker behind the Join action. All six steps are always
// instantiated (visibility-toggled) so the two steps with text fields can
// expose their focus state; the container height follows the visible step.

import { UiState, Actions } from "globals.slint";
import { ConfigureStep } from "types.slint";
import { Theme } from "theme.slint";
import { Card, CardTitle, Body, Weak, Small, Mono, BigButton, WideButton, LabeledValue, SelectableRow } from "widgets.slint";
import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

component ChoiceStep inherits VerticalLayout {
    alignment: start;
    spacing: Theme.pad-m;
    Card {
        CardTitle { text: "Set up this device"; }
        Weak {
            text: "Each duocb installation has its own permanent identity key. Pair devices by exchanging their signed identity cards.";
        }
        Rectangle { height: Theme.pad-s; }
        BigButton {
            text: "🔑 Create a new identity";
            hint: "G";
            clicked => { Actions.begin-generate(); }
        }
        WideButton {
            text: "📥 Restore a private key";
            hint: "I";
            clicked => { Actions.open-import(); }
        }
    }
}

component ImportStep inherits VerticalLayout {
    out property <bool> field-focused: entry.has-focus;
    alignment: start;
    spacing: Theme.pad-m;
    Card {
        CardTitle { text: "Restore this device identity"; }
        Body { text: "Paste the nsec private key saved from this device:"; }
        entry := LineEdit {
            input-type: InputType.password;
            placeholder-text: "nsec1…";
            text <=> UiState.in-private-key;
            edited => { Actions.fields-edited(); }
            accepted => { Actions.use-imported(); }
        }
        if UiState.import-public-key != "": LabeledValue {
            label: "Public identity:";
            value: UiState.import-public-key;
        }
        if UiState.import-public-key != "": Small {
            text: "This public identity is derived from the private key.";
        }
        if UiState.import-error != "": Text {
            text: UiState.import-error;
            color: Theme.warn;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.pad-xs; }
        HorizontalLayout {
            spacing: Theme.pad-s;
            alignment: start;
            Button {
                text: "✔ Restore key (U)";
                primary: true;
                enabled: UiState.import-valid;
                clicked => { Actions.use-imported(); }
            }
            Button {
                text: "Cancel (Esc)";
                clicked => { Actions.cancel-setup(); }
            }
        }
    }
}

component NameStep inherits VerticalLayout {
    out property <bool> field-focused: entry.has-focus;
    alignment: start;
    spacing: Theme.pad-m;
    Card {
        CardTitle { text: "Name this device"; }
        Weak { text: UiState.name-rules; }
        entry := LineEdit {
            placeholder-text: "e.g. mac-book";
            text <=> UiState.in-my-name;
            edited => { Actions.fields-edited(); }
            accepted => { Actions.save-name(); }
        }
        if UiState.name-preview != "": LabeledValue {
            label: "Signed card name:";
            value: UiState.name-preview;
        }
        if UiState.name-error != "": Text {
            text: UiState.name-error;
            color: Theme.warn;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.pad-xs; }
        HorizontalLayout {
            spacing: Theme.pad-s;
            alignment: start;
            Button {
                text: "✔ Save name (Enter)";
                primary: true;
                enabled: UiState.name-valid;
                clicked => { Actions.save-name(); }
            }
            if UiState.can-cancel-name: Button {
                text: "Cancel (Esc)";
                clicked => { Actions.cancel-name(); }
            }
        }
    }
}

component HubStep inherits VerticalLayout {
    out property <bool> field-focused: peer-card-entry.has-focus;
    alignment: start;
    spacing: Theme.pad-m;
    Card {
        HorizontalLayout {
            spacing: Theme.pad-s;
            alignment: start;
            Text { text: "This device:"; font-size: Theme.font-body; vertical-alignment: center; }
            Mono {
                text: UiState.display-identity;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button { text: "Rename (R)"; clicked => { Actions.rename(); } }
        }
        if UiState.has-identity: HorizontalLayout {
            spacing: Theme.pad-s;
            alignment: start;
            Text { text: "Fingerprint:"; font-size: Theme.font-body; vertical-alignment: center; }
            Mono {
                text: UiState.own-fingerprint;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: UiState.copied-card ? "✔ Copied" : "Copy identity card (T)";
                clicked => { Actions.copy-card(); }
            }
        }
        if UiState.has-identity: LabeledValue {
            label: "Full public identity:";
            value: UiState.public-key;
        }
        if UiState.has-identity: Small {
            text: "Paste this device's signed card into each device that should trust it, or use Trade cards below to send it over the network. Cards expire after 30 days — to renew, copy this card again and import it on every device that should keep trusting this one.";
        }
        if UiState.has-identity: Small {
            text: "The fingerprint identifies this device's key. It is what the other device shows you to check when you trade cards, and it does not change when a card is renewed.";
        }
        if UiState.has-identity: HorizontalLayout {
            spacing: Theme.pad-s;
            alignment: start;
            Button {
                text: UiState.copied-private-key ? "✔ Private key copied" : "Back up private key (B)";
                clicked => { Actions.copy-private-key(); }
            }
            Button { text: "Reset identity… (X)"; clicked => { Actions.request-reset-identity(); } }
        }
        Small { text: "Config: " + UiState.config-path; wrap: char-wrap; }
    }
    Card {
        CardTitle { text: "Trust another device"; }
        Body {
            text: "Paste the other device's signed identity card. Pairing is mutual, so import this device's card there too. A card is good for 30 days; once it expires neither device will pair until a fresh card is imported.";
        }
        peer-card-entry := LineEdit {
            placeholder-text: "{ signed identity card JSON }";
            text <=> UiState.in-peer-card;
            edited => { Actions.fields-edited(); }
            accepted => { Actions.import-peer-card(); }
        }
        if UiState.peer-card-error != "": Text {
            text: UiState.peer-card-error;
            color: Theme.warn;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Import trusted device (I)";
                primary: true;
                enabled: UiState.peer-card-valid;
                clicked => { Actions.import-peer-card(); }
            }
        }
        if UiState.peers.length > 0: Small { text: "Trusted devices (" + UiState.peers.length + "/128)"; }
        for row in UiState.peers: HorizontalLayout {
            spacing: Theme.pad-s;
            Mono {
                text: row.line;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Mono {
                text: row.note;
                color: row.expired ? Theme.warn : Palette.foreground;
                wrap: no-wrap;
                vertical-alignment: center;
            }
            Button { text: "Remove"; clicked => { Actions.remove-peer(row.public-key); } }
        }
    }
    BigButton {
        text: "🚀 Start a connection";
        hint: "S";
        clicked => { Actions.begin-server(); }
    }
    WideButton {
        text: "🔗 Join another device";
        hint: "C";
        clicked => { Actions.enter-join-picker(); }
    }
    Small {
        text: "Start makes this device host the connection — the other device joins it. Join shows your other devices and connects to the one that started.";
        horizontal-alignment: center;
    }
    // Only shown when a launch flag moved this process off the default channel
    // (see `signal-channel-badge`): the flag decides whether Start and Join can
    // reach a device that is not on this network, which is not otherwise
    // visible from the hub.
    if UiState.signal-channel-badge != "": Text {
        text: UiState.signal-channel-badge;
        color: Theme.warn;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component JoinStep inherits VerticalLayout {
    alignment: start;
    spacing: Theme.pad-m;
    Card {
        CardTitle { text: "Your devices"; }
        if UiState.peers-updated != "": Small { text: UiState.peers-updated; }
        Rectangle { height: Theme.pad-xs; }
        if UiState.peers-empty-text != "": Weak { text: UiState.peers-empty-text; }
        for row in UiState.peers: SelectableRow {
            selected: row.selected;
            clicked => { Actions.toggle-peer(row.public-key); }
            Mono {
                text: row.line;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Mono {
                text: row.note;
                color: row.expired ? Theme.warn : Palette.foreground;
                wrap: no-wrap;
                vertical-alignment: center;
            }
        }
    }
    BigButton {
        text: "🔗 Join the selected device";
        hint: "C / Enter";
        enabled: UiState.join-ready;
        clicked => { Actions.join-selected(); }
    }
    Small {
        text: UiState.join-ready
            ? "If it isn't hosting yet, press Start there soon — the join retries up to 10 times."
            : "Select the device to join.";
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        Button { text: "Back (Esc)"; clicked => { Actions.leave-join-picker(); } }
    }
}

export component HomeScreen inherits ScrollView {
    /// Whether any text field on this screen has keyboard focus (gates the
    /// plain-letter shortcuts). Only the visible step's field counts.
    out property <bool> field-focused:
        (UiState.configure-step == ConfigureStep.setup-import && import-step.field-focused)
        || (UiState.configure-step == ConfigureStep.setup-name && name-step.field-focused)
        || (UiState.configure-step == ConfigureStep.ready && hub-step.field-focused);
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-s;

        Text { text: "duocb"; font-size: Theme.font-title; font-weight: 800; }
        Body { text: "Peer-to-peer clipboard sharing between two devices."; }
        Weak {
            text: "Both devices can send and receive, and authenticate with their application identity keys.";
        }
        Rectangle { height: Theme.pad-s; }

        steps := Rectangle {
            // The steps overlap (all instantiated so field focus stays
            // referencable); size the container to the visible one.
            height: UiState.configure-step == ConfigureStep.setup-choice ? choice-step.preferred-height
                : UiState.configure-step == ConfigureStep.setup-import ? import-step.preferred-height
                : UiState.configure-step == ConfigureStep.setup-name ? name-step.preferred-height
                : UiState.configure-step == ConfigureStep.ready ? hub-step.preferred-height
                : join-step.preferred-height;

            choice-step := ChoiceStep { visible: UiState.configure-step == ConfigureStep.setup-choice; }
            import-step := ImportStep { visible: UiState.configure-step == ConfigureStep.setup-import; }
            name-step := NameStep { visible: UiState.configure-step == ConfigureStep.setup-name; }
            hub-step := HubStep { visible: UiState.configure-step == ConfigureStep.ready; }
            join-step := JoinStep { visible: UiState.configure-step == ConfigureStep.join; }
        }

        Rectangle { vertical-stretch: 1; }

        // Card setup hands over this device's signed card, so it needs an
        // identity to exist first — unlike the old quick pairing, it is offered
        // only from the configured hub.
        if UiState.configure-step == ConfigureStep.ready: WideButton {
            text: "🔗 Trade cards over the network";
            hint: "Q";
            clicked => { Actions.open-card-setup(); }
        }
        if UiState.configure-step == ConfigureStep.ready: Small {
            // No channel detail here: how the devices find each other is a
            // launch-time choice, and the card-setup screen states the one
            // actually in use (`setup-channel-note`). Naming it twice is how
            // one copy goes stale on a --lan-only or --nostr-only run.
            text: "Use this when you can't copy and paste identity cards between the two devices. They find each other over the network with a short PIN, and you check fingerprints before trusting.";
            horizontal-alignment: center;
        }
        if UiState.configure-step == ConfigureStep.setup-choice || UiState.configure-step == ConfigureStep.ready: Small {
            text: "duocb v" + UiState.app-version;
            horizontal-alignment: center;
        }
    }
}
