// The local-only quick-pair screen. Hosting advertises over Bonjour/DNS-SD and
// joining accepts only a LAN-only PIN. Nothing here is persisted, and the
// credentials last one session.

import { UiState, Actions } from "globals.slint";
import { Theme } from "theme.slint";
import { Card, CardTitle, Weak, Small, Mono, BigButton, WideButton, BackHeader } from "widgets.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export component QuickScreen inherits ScrollView {
    out property <bool> field-focused:
        pin-a.has-focus || pin-b.has-focus || ip-entry.has-focus;
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-m;

        BackHeader { title: "Quick options"; }
        Weak {
            text: "Pair on the local network — nothing is saved, and the credentials last one session.";
        }

        Card {
            CardTitle { text: "Local network only"; }
            Small {
                text: "No third-party server participates: discovery uses Bonjour (DNS-SD) and traffic stays direct between the devices. If multicast is blocked, the joiner can type the host's IP shown while hosting. This is a discovery policy, not a packet-level subnet boundary; reflected mDNS, a VPN/overlay, or globally routed addresses can extend the direct path beyond a conventional LAN.";
            }
        }

        Card {
            CardTitle { text: "Show a PIN"; }
            BigButton {
                text: "📡 Show a PIN on this device";
                hint: "S";
                clicked => { Actions.begin-server(); }
            }
            Small {
                text: "A short PIN appears on this device. Enter it on the other device within a minute — it renews every 60 seconds until a device pairs.";
            }
        }

        // Type the local-only PIN shown on the other device. An optional host-IP
        // field appears once the PIN is valid — fill it only when automatic
        // discovery (mDNS) is blocked on the network.
        Card {
            CardTitle { text: "Enter a PIN"; }

            pin-form := VerticalLayout {
                alignment: start;
                spacing: Theme.pad-xs;
                // Two four-character groups (dash as a static label,
                // auto-advance, backspace hop); Enter in either group joins.
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.pad-xs;
                    pin-a := LineEdit {
                        min-width: 96px;
                        horizontal-alignment: center;
                        font-family: UiState.mono-font;
                        placeholder-text: "XXXX";
                        text <=> UiState.in-pin-a;
                        edited => {
                            Actions.fields-edited();
                            if UiState.pin-a-full { pin-b.focus(); }
                        }
                        accepted => { Actions.join-quick(); }
                    }
                    Text {
                        text: "-";
                        vertical-alignment: center;
                        font-size: Theme.font-pin;
                    }
                    pin-b := LineEdit {
                        min-width: 96px;
                        horizontal-alignment: center;
                        font-family: UiState.mono-font;
                        placeholder-text: "XXXX";
                        text <=> UiState.in-pin-b;
                        edited => { Actions.fields-edited(); }
                        key-pressed(event) => {
                            if event.text == Key.Backspace && self.text == "" {
                                pin-a.focus();
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                        accepted => { Actions.join-quick(); }
                    }
                }
                // Neutral progress while typing; a warning only once the whole
                // PIN is in but fails its checksum.
                if UiState.pin-incomplete != "": Weak {
                    text: UiState.pin-incomplete;
                }
                if UiState.pin-invalid: Text {
                    text: "Not a valid PIN (check for typos)";
                    color: Theme.warn;
                    font-size: Theme.font-body;
                }
                if UiState.pin-not-local: Text {
                    text: "That PIN is not for local-only quick pairing";
                    color: Theme.warn;
                    font-size: Theme.font-body;
                }
            }

            // Optional host-IP entry, revealed for a valid local-only PIN. Kept
            // instantiated (so `ip-entry` can report focus for shortcut gating)
            // and collapsed to zero height when hidden.
            ip-wrap := Rectangle {
                height: UiState.pin-is-lan-only ? ip-col.preferred-height : 0px;
                clip: true;
                ip-col := VerticalLayout {
                    alignment: start;
                    spacing: Theme.pad-xs;
                    Small {
                        text: "Optional — only if the other device isn't found automatically. Type the IP it shows.";
                    }
                    // The network part of this device's subnet is locked ahead of
                    // the field, so the user types only the host part (the whole
                    // address is still accepted if pasted).
                    HorizontalLayout {
                        spacing: Theme.pad-xs;
                        if UiState.join-ip-prefix != "": Mono {
                            text: UiState.join-ip-prefix;
                            vertical-alignment: center;
                        }
                        ip-entry := LineEdit {
                            font-family: UiState.mono-font;
                            placeholder-text: UiState.join-ip-prefix != "" ? UiState.join-ip-placeholder : "Host IP (optional)";
                            text <=> UiState.in-join-ip;
                            edited => { Actions.fields-edited(); }
                            accepted => { Actions.join-quick(); }
                        }
                    }
                    if UiState.join-ip-hint != "": Small {
                        text: UiState.join-ip-hint;
                    }
                    if UiState.join-ip-error != "": Text {
                        text: UiState.join-ip-error;
                        color: Theme.warn;
                        font-size: Theme.font-body;
                    }
                }
            }

            WideButton {
                text: "🔗 Join";
                enabled: UiState.dial-ready;
                clicked => { Actions.join-quick(); }
            }
            Small {
                text: "Type the PIN shown on the hosting device.";
            }
        }
    }
}
