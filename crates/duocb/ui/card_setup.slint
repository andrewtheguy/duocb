// Card setup: bootstrap trust between two devices that cannot copy and paste
// identity cards to each other. A rotating PIN authenticates a short-lived
// connection, both devices swap signed cards over it, and the user confirms the
// pairing code — one value derived from both keys, shown identically on both
// screens — before anything is trusted. How the two devices find each other
// (local network, relays, or local-then-relays) is chosen at launch, governs
// clipboard sessions too, and is described by `signal-channel-note`. No
// clipboard content ever crosses a card-setup connection — that is what the
// configure-mode session is for.

import { UiState, Actions } from "globals.slint";
import { Theme } from "theme.slint";
import { Card, CardTitle, Body, Weak, Small, Mono, BigButton, WideButton, BackHeader, LabeledValue } from "widgets.slint";
import { Button, LineEdit, ScrollView } from "std-widgets.slint";

// Step one: choose a role. Show a PIN here, or type the one shown there.
export component CardSetupScreen inherits ScrollView {
    out property <bool> field-focused:
        pin-a.has-focus || pin-b.has-focus || ip-entry.has-focus;
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-m;

        BackHeader { title: "Trade cards"; }
        Weak {
            text: "Trade identity cards with another device over the network — for when you can't copy and paste a card between them.";
        }

        Card {
            CardTitle { text: "How this works"; }
            Small {
                text: "One device shows a PIN and the other types it. Both then show one pairing code: check that the two screens display the identical code before you import. Afterwards the two devices are paired as usual, and you share the clipboard from the home screen.";
            }
        }

        Card {
            CardTitle { text: UiState.signal-channel-title; }
            Small {
                text: UiState.signal-channel-note;
            }
        }

        Card {
            CardTitle { text: "Show a PIN"; }
            BigButton {
                text: "📡 Show a PIN on this device";
                hint: "S";
                clicked => { Actions.host-card-setup(); }
            }
            Small {
                text: "A short PIN appears on this device. Enter it on the other device within a minute — it renews every 60 seconds until a device answers.";
            }
        }

        // Type the PIN shown on the other device. An optional host-IP field
        // appears once the PIN is valid — fill it only when automatic discovery
        // (mDNS) is blocked on the network.
        Card {
            CardTitle { text: "Enter a PIN"; }

            pin-form := VerticalLayout {
                alignment: start;
                spacing: Theme.pad-xs;
                // Two four-character groups (dash as a static label,
                // auto-advance, backspace hop); Enter in either group joins.
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.pad-xs;
                    pin-a := LineEdit {
                        min-width: 96px;
                        horizontal-alignment: center;
                        font-family: UiState.mono-font;
                        placeholder-text: "XXXX";
                        text <=> UiState.in-pin-a;
                        edited => {
                            Actions.fields-edited();
                            if UiState.pin-a-full { pin-b.focus(); }
                        }
                        accepted => { Actions.join-card-setup(); }
                    }
                    Text {
                        text: "-";
                        vertical-alignment: center;
                        font-size: Theme.font-pin;
                    }
                    pin-b := LineEdit {
                        min-width: 96px;
                        horizontal-alignment: center;
                        font-family: UiState.mono-font;
                        placeholder-text: "XXXX";
                        text <=> UiState.in-pin-b;
                        edited => { Actions.fields-edited(); }
                        key-pressed(event) => {
                            if event.text == Key.Backspace && self.text == "" {
                                pin-a.focus();
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                        accepted => { Actions.join-card-setup(); }
                    }
                }
                // Neutral progress while typing; a warning only once the whole
                // PIN is in but fails its checksum.
                if UiState.pin-incomplete != "": Weak {
                    text: UiState.pin-incomplete;
                }
                if UiState.pin-invalid: Text {
                    text: "Not a valid PIN (check for typos)";
                    color: Theme.warn;
                    font-size: Theme.font-body;
                }
            }

            // Optional host-IP entry, for the local-network channel only —
            // there is no side-channel listener to reach on a nostr-only run.
            // Kept instantiated (so `ip-entry` can report focus for shortcut
            // gating) and hidden rather than dropped.
            ip-col := VerticalLayout {
                alignment: start;
                spacing: Theme.pad-xs;
                visible: UiState.signal-lan-enabled;
                // `visible` alone still reserves the layout space, which would
                // leave a hole where the field was, so the height is pinned to
                // zero as well. Both bounds are needed: the column's min-height
                // comes from its children and would otherwise win over the cap.
                min-height: UiState.signal-lan-enabled ? ip-col.preferred-height : 0px;
                max-height: UiState.signal-lan-enabled ? ip-col.preferred-height : 0px;
                Small {
                    text: "Optional — only if the other device isn't found automatically. Type the IP it shows.";
                }
                // The network part of this device's subnet is locked ahead of
                // the field, so the user types only the host part (the whole
                // address is still accepted if pasted).
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    if UiState.join-ip-prefix != "": Mono {
                        text: UiState.join-ip-prefix;
                        vertical-alignment: center;
                    }
                    ip-entry := LineEdit {
                        font-family: UiState.mono-font;
                        placeholder-text: UiState.join-ip-prefix != "" ? UiState.join-ip-placeholder : "Host IP (optional)";
                        text <=> UiState.in-join-ip;
                        edited => { Actions.fields-edited(); }
                        accepted => { Actions.join-card-setup(); }
                    }
                }
                if UiState.join-ip-hint != "": Small {
                    text: UiState.join-ip-hint;
                }
                if UiState.join-ip-error != "": Text {
                    text: UiState.join-ip-error;
                    color: Theme.warn;
                    font-size: Theme.font-body;
                }
            }

            WideButton {
                text: "🔗 Join";
                hint: "C";
                enabled: UiState.dial-ready;
                clicked => { Actions.join-card-setup(); }
            }
            Small {
                text: "Type the PIN shown on the hosting device.";
            }
        }
    }
}

// Step two: this device is showing a PIN, or dialing one.
export component CardPairingScreen inherits ScrollView {
    out property <bool> field-focused: false;
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-m;

        BackHeader { title: "Trade cards"; }
        Body { text: "Status: " + UiState.status-text; }

        if UiState.pin-display != "": VerticalLayout {
            spacing: Theme.pad-xs;
            alignment: start;
            Body {
                text: "Type this PIN on the other device:";
                horizontal-alignment: center;
            }
            Text {
                text: UiState.pin-display;
                font-family: UiState.mono-font;
                font-size: Theme.font-pin;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.pad-s;
                Button {
                    text: UiState.copied-pin ? "✔ Copied" : "Copy PIN (" + UiState.cmd-label + "+T)";
                    clicked => { Actions.copy-pin(); }
                }
                Button {
                    text: "↻ New PIN (R)";
                    clicked => { Actions.refresh-pin(); }
                }
            }
            Body {
                text: UiState.pin-countdown;
                horizontal-alignment: center;
            }
            // If the other device can't find this one automatically (multicast
            // blocked), the joiner can type this IP.
            if UiState.host-lan-ip != "": Small {
                text: "Can't find it automatically? Enter this IP on the other device:";
                horizontal-alignment: center;
            }
            if UiState.host-lan-ip != "": Text {
                text: UiState.host-lan-ip;
                font-family: UiState.mono-font;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: "⏹ Cancel (Esc)";
                clicked => { Actions.go-back(); }
            }
        }
    }
}

// Step three: the cards have crossed. Both devices now derive one pairing code
// from the same pair of keys and the user checks the two screens show the
// identical value before anything is written to the trusted list.
export component CardConfirmScreen inherits ScrollView {
    out property <bool> field-focused: false;
    viewport-width: root.width;
    viewport-height: max(root.height, content.preferred-height);
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: true;

    content := VerticalLayout {
        alignment: start;
        spacing: Theme.pad-m;

        BackHeader { title: "Check the pairing code"; }

        // The instruction comes first: the whole screen is one comparison, and
        // it only means anything if the user knows what to compare.
        Card {
            CardTitle { text: "Compare the pairing code"; }
            Body {
                text: "Both devices now show a pairing code built from both keys. The code below must be identical on the two screens. If it differs anywhere, press Cancel — something else answered your PIN.";
            }
        }

        Card {
            CardTitle { text: "Pairing code"; }
            Text {
                text: UiState.pairing-code;
                font-family: UiState.mono-font;
                font-size: Theme.font-heading;
                font-weight: 700;
                wrap: word-wrap;
            }
            LabeledValue {
                label: "This device:";
                value: UiState.display-identity;
            }
            LabeledValue {
                label: "Incoming card:";
                value: UiState.incoming-name;
            }
            if UiState.incoming-expiry != "": Small {
                text: UiState.incoming-expiry;
            }
        }

        WideButton {
            text: "✔ Codes match — import";
            hint: "I / Enter";
            clicked => { Actions.import-received-card(); }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Cancel (C / Esc)";
                clicked => { Actions.cancel-received-card(); }
            }
        }
        Small {
            text: "Importing adds this device to the trusted list. Do the same on the other device, then use Start and Join on the home screen to share the clipboard.";
        }
    }
}
