// Shared enums and row structs. The exported enums are the routing types on
// both sides: the Rust `App` stores the generated equivalents directly.

/// Which screen is showing. A clipboard session has one screen for both
/// devices: they pick each other and the app decides which one hosts, so there
/// is nothing role-specific left to show. The three `card-*` screens are the
/// trust-bootstrap path, which never carries clipboard content at all.
export enum Screen {
    /// The configure mode's wizard/hub — the primary flow.
    home,
    /// Card setup: choose to show a PIN or to type one.
    card-setup,
    /// Card setup in progress: showing a PIN, or dialing one.
    card-pairing,
    /// Card setup finished: compare fingerprints, then import or cancel.
    card-confirm,
    /// A clipboard session with one chosen device, whichever half this device
    /// drew.
    session,
}

/// Where the configure mode's home-screen flow currently is.
export enum ConfigureStep {
    /// No secret: choose between generating a new one and importing one.
    setup-choice,
    /// Restore an existing application private key.
    setup-import,
    /// Enter/confirm this device's short name.
    setup-name,
    /// Fully configured: the hub — device identity + the connect action.
    ready,
    /// The device picker, shown only after choosing Connect on the hub.
    connect,
}

/// One row of a device list. `line` is fully composed in Rust and
/// `public-key` is the stable selection key.
/// One trusted-device / candidate projection. `note` is kept out of `line` so
/// it can render as its own non-wrapping element — a card's expiry date must
/// never be broken across two lines by the char-wrapping identity text.
export struct PeerRow {
    public-key: string,
    line: string,
    note: string,
    /// Drives the note's warning color — lapsed trust reads as a problem, not
    /// as one more date in the row.
    expired: bool,
    selected: bool,
}

/// One inbox/outbox item projection. `peek-text` is only populated while the
/// item is expanded so collapsed items never ship their content to the UI.
export struct ClipRow {
    time: string,
    size: string,
    crc: string,
    expanded: bool,
    peek-text: string,
    peek-lines: int,
    truncated-note: string,
    /// Whether this row's Copy button should flash "✔ Copied" (set from the
    /// active copy feedback during sync).
    copied: bool,
}

/// One connection-path row for the on-demand modal; the marker/color encode
/// selected/kind (green direct, amber relay), composed in Rust.
export struct PathRow {
    marker: string,
    color: color,
    display: string,
}
