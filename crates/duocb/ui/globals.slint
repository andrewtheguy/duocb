// The UI <-> Rust surface. `UiState` is written by the Rust side's single
// push-style `App::sync` projection (plus two-way field bindings); `Actions`
// carries every user intent back into Rust, which mutates the `App` state and
// re-syncs. No UI-side state beyond what lives here.

import { Screen, ConfigureStep, PeerRow, ClipRow, PathRow } from "types.slint";

export global UiState {
    // Per-platform font families, set once at startup from Rust ("" = the
    // renderer's default). Slint takes a single family name, so the platform
    // pick happens on the Rust side.
    in property <string> ui-font;
    in property <string> mono-font: "monospace";
    /// The command-modifier label used in shortcut hints: "⌘" on macOS, "Ctrl"
    /// elsewhere. Set once at startup from Rust, since Slint can't tell which
    /// build target it is running on. Matches Slint's `control` modifier, which
    /// is ⌘ on macOS and Ctrl on every other platform.
    in property <string> cmd-label: "Ctrl";
    /// This build's version (e.g. "0.0.26"), set once at startup from Rust's
    /// `CARGO_PKG_VERSION`. Shown on the home screen.
    in property <string> app-version;

    // Navigation / shared status.
    in property <Screen> screen;
    in property <ConfigureStep> configure-step;
    in property <string> status-text;
    in property <bool> connected;
    in property <bool> server-running;
    in property <bool> client-active;
    /// Error banner text; "" hides the banner.
    in property <string> error;

    // Configure identity / wizard. The private key is only present in the
    // explicitly masked restore field; normal projection exposes public data.
    in property <string> display-identity;
    in property <bool> has-identity;
    /// This device's key fingerprint — the value the user compares against the
    /// other device during card setup, and the one shown beside each trusted peer.
    in property <string> own-fingerprint;
    in property <string> public-key;
    in property <string> config-path;
    // Per-button "✔ Copied" feedback: exactly one is true while a copy is fresh
    // (inbox/outbox rows carry their own `copied` flag in ClipRow).
    in property <bool> copied-card;
    in property <bool> copied-private-key;
    in property <bool> copied-pin;
    in property <bool> name-valid;
    /// "Broadcast as" preview when the name is valid, "" otherwise.
    in property <string> name-preview;
    /// Validation message for a non-empty invalid name, "" otherwise.
    in property <string> name-error;
    in property <bool> can-cancel-name;
    in property <bool> import-valid;
    /// Fingerprint of a valid import entry, "" otherwise.
    in property <string> import-public-key;
    /// Why a non-empty import entry is not a valid secret, "" otherwise.
    in property <string> import-error;
    /// The name rules line under the name field (composed in Rust so the max
    /// length constant lives in one place).
    in property <string> name-rules;
    in property <bool> peer-card-valid;
    in property <string> peer-card-error;

    // Device picker.
    in property <[PeerRow]> peers;
    /// "updated 2m ago", or "" before the first fetch.
    in property <string> peers-updated;
    /// Empty-list placeholder, "" while the list has rows.
    in property <string> peers-empty-text;
    in property <bool> join-ready;

    // Server / running-session identity.
    in property <string> joined-peer;
    in property <string> node-id-short;
    in property <string> peer-node-id-short;
    /// The persistent application public key shown in the pairing summary.
    in property <string> session-public-key;
    /// The host's LAN IPv4 while the local-network channel is in use (so the
    /// joiner can type it for the manual-IP side channel), "" on the nostr-only
    /// channel or before an address is known.
    in property <string> host-lan-ip;
    in property <string> pin-display;
    /// "refreshes in 42s", composed in Rust; "" while no PIN shows.
    in property <string> pin-countdown;

    // Client join forms.
    /// True when the PIN entry is full-length but fails validation (a typo).
    in property <bool> pin-invalid;
    /// Neutral "keep typing — N of M characters" hint while the PIN entry is
    /// non-empty but shorter than a full PIN; "" otherwise. Composed in Rust so
    /// the PIN length lives in one place.
    in property <string> pin-incomplete;
    /// True once the first PIN group is full, so the entry auto-advances focus
    /// to the second group (Apple-style code entry).
    in property <bool> pin-a-full;
    /// The locked network prefix of this device's subnet (e.g. "10.22.33."),
    /// shown non-editable ahead of the host-IP field so the user types only the
    /// host part. "" when no subnet was detected (free full-IP entry).
    in property <string> join-ip-prefix;
    /// Placeholder for the host-IP field describing the editable tail (e.g.
    /// "last octet"); "" when no subnet was detected (free full-IP entry).
    in property <string> join-ip-placeholder;
    /// A "valid range" hint for a partial-octet subnet (e.g. a /20); "" otherwise.
    in property <string> join-ip-hint;
    /// The host-IP entry error ("IP out of range for …" / "Not a valid IPv4
    /// address"); "" when the entry is empty or valid.
    in property <string> join-ip-error;
    in property <bool> dial-ready;

    // The signaling channel this process was launched with. It governs both
    // trading cards and clipboard sessions, so these read "how the two devices
    // find each other", not "how card setup works".
    /// Whether the local-network rendezvous is in use, so the screens offer the
    /// manual host-IP path (which only exists on that channel).
    in property <bool> signal-lan-enabled;
    /// The heading and body describing how the two devices will find each other,
    /// composed in Rust.
    in property <string> signal-channel-title;
    in property <string> signal-channel-note;
    /// A one-line hub banner naming a non-default channel; "" on the default,
    /// where the card-setup screen's note is the only place it is spelled out.
    in property <string> signal-channel-badge;

    // Card-setup confirmation. The user compares `incoming-fingerprint` here
    // against `own-fingerprint` as shown on the other device; they must match
    // before the card is worth importing.
    in property <string> incoming-name;
    in property <string> incoming-fingerprint;
    /// The incoming card's expiry line ("expires 2026-09-13"), same wording as
    /// the trusted-device rows.
    in property <string> incoming-expiry;

    // Session panel.
    in property <bool> sent-flash;
    in property <bool> outbox-present;
    in property <ClipRow> outbox;
    in property <[ClipRow]> inbox;
    /// "Inbox (2)", composed in Rust.
    in property <string> inbox-title;

    // Modals.
    in property <bool> show-reset-identity;
    in property <bool> show-conn-path;
    in property <[PathRow]> conn-paths;

    // Form inputs, two-way bound to their fields. The Rust side mirrors them
    // on every edit and writes them back on sync (authoritative after resets).
    in-out property <string> in-my-name;
    in-out property <string> in-private-key;
    in-out property <string> in-peer-card;
    in-out property <string> in-pin-a;
    in-out property <string> in-pin-b;
    /// The joiner's optional host-IP entry (shown only for a LAN-only PIN).
    in-out property <string> in-join-ip;
    in-out property <string> in-compose;
}

export global Actions {
    // Navigation.
    callback go-back();
    callback open-card-setup();
    callback dismiss-error();

    // Configure wizard.
    callback begin-generate();
    callback open-import();
    callback cancel-setup();
    callback use-imported();
    callback save-name();
    callback cancel-name();
    callback rename();
    callback copy-card();
    callback copy-private-key();
    callback request-reset-identity();
    callback confirm-reset-identity();
    callback cancel-reset-identity();

    // Hub / device picker.
    callback begin-server();
    callback enter-join-picker();
    callback leave-join-picker();
    callback toggle-peer(public-key: string);
    callback remove-peer(public-key: string);
    callback import-peer-card();
    callback join-selected();

    // Card setup.
    /// Show a PIN on this device so the other one can type it.
    callback host-card-setup();
    /// Dial what the card-setup entry holds (the typed PIN, plus an optional
    /// host IP).
    callback join-card-setup();
    /// Trust the card that arrived — only after the user has compared
    /// fingerprints.
    callback import-received-card();
    /// Discard the card that arrived and go back.
    callback cancel-received-card();
    callback disconnect();

    // Server credentials.
    callback copy-pin();
    callback refresh-pin();

    // Session panel.
    callback send-clipboard();
    callback compose-send();
    callback clear-inbox();
    callback inbox-copy(index: int);
    callback inbox-peek(index: int);
    callback outbox-copy();
    callback outbox-peek();
    callback query-conn-path();
    callback close-conn-path();

    // Input mirroring: fired by every field's `edited` so the Rust mirrors
    // and derived validation stay current.
    callback fields-edited();

    // Global shortcuts; returns true when the key was consumed. `plain` means
    // no modifier is held at all; `command` means exactly the platform command
    // modifier (Slint's `control`: ⌘ on macOS, Ctrl elsewhere) — shortcuts
    // never fire with extra modifiers, matching the previous toolkit.
    callback global-key(text: string, plain: bool, command: bool, field-focused: bool) -> bool;
}
